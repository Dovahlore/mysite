# Copy this file to .env on the deployment host and replace every placeholder.
# Never commit the real .env file.

# Redis cache
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_MAXMEMORY=64mb

# Resource limits sized for a 2 GB host
WEB_MEMORY_LIMIT=512m
SCHEDULER_MEMORY_LIMIT=384m
MYSQL_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=128m
NGINX_MEMORY_LIMIT=96m
DJANGO_DEBUG=0

# MySQL container root password
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_DATABASE=mysite
MYSQL_USER=root
MYSQL_HOST=db
MYSQL_PORT=3306

# AI models and provider keys are configured in ai_config.yaml.

# Dedicated MySQL account used only by the Assistant's SELECT queries
AGENT_DB_USER=dovah_agent_ro
AGENT_DB_PASSWORD=replace-with-a-different-long-random-password
AGENT_DB_NAME=mysite
AGENT_DB_HOST=db
AGENT_DB_PORT=3306

IGPSPORT_USERNAME=你的账号
IGPSPORT_PASSWORD=修改后的新密码
IGPSPORT_LOOKBACK_DAYS=14
IGPSPORT_SYNC_TIMEOUT_SECONDS=1800
